# PatentQ Environment Configuration
# Copy this file to .env and fill in the provider you want to use.

# Option 1: Local LLM via Ollama (no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Option 2: Google Gemini API
GOOGLE_API_KEY= "your_google_api_key_here"

# Option 3: OpenAI API (or OpenAI-compatible endpoint)
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Option 4: Groq API
GROQ_API_KEY=

# Optional: PatentsView API key (if you have one; PatentQ also queries free zero-key sources)
PATENTSVIEW_API_KEY=
